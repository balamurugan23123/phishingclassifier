# Optional free-tier API keys (works offline without these)
VT_API_KEY=
URLSCAN_API_KEY=
# Optional: Google Safe Browsing Lookup API (needs a key with the Safe
# Browsing API enabled). When set, live enrichment also batch-checks URLs.
GOOGLE_API_KEY=

# Optional: max age (seconds) of cached VirusTotal/urlscan verdicts
# before they are refetched. Default 86400 (24h); 0 disables caching.
# Can also be set per-run with the CLI flag --vt-cache-ttl.
VT_CACHE_TTL=

# Optional: Sentry error monitoring. When set, crashes in the CLI and
# dashboard are reported (evidence-scrubbed: subjects/bodies/URLs never
# leave the process). Leave empty to disable entirely.
SENTRY_DSN=
